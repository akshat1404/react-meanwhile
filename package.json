{
  "name": "react-meanwhile-monorepo",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently -n lib,playground -c blue,green \"pnpm --filter react-meanwhile dev\" \"pnpm --filter playground dev\"",
    "build": "pnpm --filter react-meanwhile build",
    "test": "pnpm --filter react-meanwhile test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
